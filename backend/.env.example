# DDDUi backend environment template.
# Copy this file to `.env` (same directory) and fill in values as needed.
# `.env` is gitignored — it is NEVER committed. Do not commit real secrets.

# JWT secret used to encrypt stored provider API keys.
# Leave EMPTY to let dodiddoneui auto-generate a random secret on first launch
# and persist it in the DB (recommended for a fresh single-user install).
# Set it ONLY if you need to migrate/restore an existing data dir whose keys
# were encrypted with a known secret. Use a long, random, base64 string.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
